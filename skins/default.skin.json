{
  "format": "worldmusicclub-skin",
  "version": 1,
  "id": "wmc-default",
  "name": "WorldMusicClub Default",
  "author": "WorldMusicClub contributors",
  "license": "MIT",
  "attribution": "Original WorldMusicClub presentation defaults.",
  "palette": {
    "background": "#0B1220",
    "surface": "#111C2E",
    "foreground": "#F8FAFC",
    "muted": "#B8C6DA",
    "outline": "#94A3B8",
