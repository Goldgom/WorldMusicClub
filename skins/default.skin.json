      "fill": "#FBBF24",
      "foreground": "#111111",
      "outline": "#111111",
      "marker": "circle",
      "pattern": "solid"
    },
    "machine": {
      "fill": "#67E8F9",
      "foreground": "#111111",
      "outline": "#111111",
      "marker": "diamond",
      "pattern": "stripes"
    }
  },
  "keyboard": {
    "white": "#F8FAFC",
    "white_foreground": "#111111",
    "black": "#111111",
