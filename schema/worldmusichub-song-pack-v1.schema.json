{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worldmusichub:song-pack:v1",
  "title": "WorldMusicHub song-pack manifest v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "songs"
  ],
  "properties": {
    "format": {
      "const": "worldmusichub-song-pack"
    },
    "version": {
      "const": 1
    },
    "songs": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "folder"
        ],
        "properties": {
          "folder": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\u0000-\\u001f])[^/]+(?:/[^/]+)*$"
          }
        }
      }
    }
  }
}
